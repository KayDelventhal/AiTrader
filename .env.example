# Copy to .env; never commit actual secrets. Existing .env is not overwritten.
APP_MODE=DEMO
APP_TIMEZONE=Europe/Berlin
REPORT_CURRENCY=EUR
# Empty selects the workspace-local SQLite preview. Compose injects PostgreSQL.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
EXTERNAL_REQUESTS_ENABLED=false
LIVE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
LLM_DAILY_BUDGET_EUR=0
SEARCH_DAILY_BUDGET_EUR=0
BRAVE_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
EODHD_API_KEY=
SEC_USER_AGENT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRADING212_API_KEY=
TRADING212_API_SECRET=
BROKER_ENVIRONMENT=disabled
MAX_ORDER_EUR=500
MAX_POSITION_EUR=1000
APPROVAL_TTL_SECONDS=120
# Preview accounts use these defaults ONLY with the loopback-only DEMO server.
DEMO_OWNER_PASSWORD=local-demo-owner
DEMO_PARTNER_PASSWORD=local-demo-partner
